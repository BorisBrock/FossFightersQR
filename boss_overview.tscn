[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/boss_overview.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/onboarding/theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/onboarding/table.png" id="3_table"]
[ext_resource type="Shader" path="res://assets/onboarding/shaders/table.gdshader" id="4_table_shader"]
[ext_resource type="Texture2D" path="res://assets/icon_settings.png" id="5_settings_icon"]
[ext_resource type="Script" path="res://scripts/settings_button.gd" id="6_settings"]
[ext_resource type="AudioStream" path="res://assets/sounds/fanfare.ogg" id="7_fanfare"]

[sub_resource type="ShaderMaterial" id="table_material"]
shader = ExtResource("4_table_shader")
shader_parameter/dim = 0.5

[sub_resource type="StyleBoxFlat" id="picture_frame"]
draw_center = false
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.72, 0.54, 0.22, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="BossOverview" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Table" type="TextureRect" parent="."]
material = SubResource("table_material")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("3_table")
expand_mode = 1
stretch_mode = 6

[node name="Stage" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 14.0
offset_right = -20.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Stage"]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 22
theme_override_constants/margin_bottom = 24

[node name="Layout" type="VBoxContainer" parent="Stage/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Stage/Margin/Layout"]
layout_mode = 2

[node name="Settings" type="TextureButton" parent="Stage/Margin/Layout/Header"]
modulate = Color(1, 1, 1, 0.75)
custom_minimum_size = Vector2(56, 56)
layout_mode = 2
size_flags_vertical = 0
focus_mode = 0
texture_normal = ExtResource("5_settings_icon")
ignore_texture_size = true
stretch_mode = 5
script = ExtResource("6_settings")

[node name="Titles" type="VBoxContainer" parent="Stage/Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Name" type="Label" parent="Stage/Margin/Layout/Header/Titles"]
layout_mode = 2
theme_type_variation = &"Title"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Tagline" type="Label" parent="Stage/Margin/Layout/Header/Titles"]
layout_mode = 2
theme_type_variation = &"Hint"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Balance" type="Control" parent="Stage/Margin/Layout/Header"]
custom_minimum_size = Vector2(56, 0)
layout_mode = 2
mouse_filter = 2

[node name="Scroll" type="ScrollContainer" parent="Stage/Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Stage/Margin/Layout/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Picture" type="TextureRect" parent="Stage/Margin/Layout/Scroll/Content"]
clip_contents = true
custom_minimum_size = Vector2(0, 340)
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 6

[node name="Frame" type="Panel" parent="Stage/Margin/Layout/Scroll/Content/Picture"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
