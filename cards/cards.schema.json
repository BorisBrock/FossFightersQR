{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/cards.schema.json",
  "title": "Card collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cards"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/definitions/card" }
    }
  },
  "definitions": {
    "localizedText": {
      "description": "Text keyed by language code, e.g. de, en, pt-BR. 'de', the language of the printed cards, is required as fallback.",
      "type": "object",
      "required": ["de"],
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "strength"],
      "properties": {
        "type": { "enum": ["attack", "support", "heal"] },
        "strength": { "type": "integer", "minimum": 0 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qr", "deck"],
      "not": { "required": ["race", "hero_class"] },
      "properties": {
        "qr": {
          "description": "Unique card ID, printed as a QR code. 1-15 characters: letters, digits and _ - + / = (so base64 values like BAEAAA== work).",
          "type": "string",
          "pattern": "^[A-Za-z0-9_+/=-]{1,15}$"
        },
        "deck": {
          "enum": [
            "classes", "characters",
            "dryad", "goblin", "halfling", "elf", "dwarf", "troll",
            "thief", "magician", "warrior", "paladin", "shaman", "druid",
            "loot", "items"
          ]
        },
        "race": {
          "description": "Makes this a character card: players show it during onboarding to choose this race.",
          "enum": ["halfling", "dwarf", "elf", "troll", "goblin", "dryad"]
        },
        "hero_class": {
          "description": "Makes this a class card: players show it during onboarding to choose this class.",
          "enum": ["paladin", "magician", "warrior", "thief", "druid", "shaman"]
        },
        "title": {
          "description": "Left out for cards without a title.",
          "$ref": "#/definitions/localizedText"
        },
        "effect": { "$ref": "#/definitions/localizedText" },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/definitions/symbol" }
        },
        "level": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    }
  }
}
